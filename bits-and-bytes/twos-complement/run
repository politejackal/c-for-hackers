#!/usr/bin/exec-suid -- /usr/local/bin/python -I

import os
import random
import stat
import sys

# Progress is saved here after every part, so nobody has to start over.
# The file belongs to root, so it cannot be faked from the hacker account.
CHECKPOINT = "/root/.c-for-hackers-twos-complement"


def load_checkpoint():
    try:
        info = os.lstat(CHECKPOINT)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
            return 0
        with open(CHECKPOINT) as f:
            done = int(f.read().strip())
        return done if 0 <= done <= 5 else 0
    except (OSError, ValueError):
        return 0


def save_checkpoint(done):
    try:
        with open(CHECKPOINT, "w") as f:
            f.write(str(done))
        os.chmod(CHECKPOINT, 0o600)
    except OSError:
        pass  # No checkpoint this time; the challenge still works.


def signed(byte):
    """Read a byte (0-255) the two's complement way."""
    return byte - 256 if byte >= 128 else byte


def ask_number(question):
    while True:
        print(question)
        text = input("> ").strip()
        try:
            return int(text)
        except ValueError:
            print("That is not a number. Type something like 42 or -42.")
            print()


def ask_hex_byte(question):
    while True:
        print(question)
        text = input("> ").strip().lower().replace(" ", "")
        if text.startswith("0x"):
            text = text[2:]
        if text and len(text) <= 2 and all(c in "0123456789abcdef" for c in text):
            return int(text, 16)
        print("That is not a hex byte. Use 1 or 2 hex digits, like 0xFB.")
        print()


def drill(total, make_question):
    """Keep asking fresh questions until `total` of them are answered right."""
    right = 0
    while right < total:
        if make_question(right + 1, total):
            print("Correct!")
            right += 1
        else:
            print("Let's try another one.")
        print()


def part1():
    print("Part 1: read a signed byte.")
    print()

    def question(i, total):
        byte = random.randint(129, 254)
        answer = ask_number(f"[{i}/{total}] What is {byte:08b} as a signed byte?")
        if answer == signed(byte):
            return True
        print(f"Not quite. {byte:08b} as a signed byte is {signed(byte)}.")
        return False

    drill(2, question)


def part2():
    print("Part 2: make a number negative.")
    print("Answer with the byte in hex, like 0xFB.")
    print()

    def question(i, total):
        value = random.randint(2, 127)
        byte = (-value) & 0xFF
        answer = ask_hex_byte(f"[{i}/{total}] What byte stores -{value} ?")
        if answer == byte:
            return True
        print(f"Not quite. -{value} is stored as 0x{byte:02X} ({byte:08b}).")
        return False

    drill(2, question)


def part3():
    print("Part 3: same bits, two meanings.")
    print()

    def question(i, total):
        byte = random.randint(129, 254)
        answer = ask_number(f"[{i}/{total}] What is 0x{byte:02X} as an unsigned byte?")
        if answer != byte:
            print(f"Not quite. 0x{byte:02X} as an unsigned byte is {byte}.")
            return False
        answer = ask_number(f"      And what is the same 0x{byte:02X} as a signed byte?")
        if answer != signed(byte):
            print(f"Not quite. 0x{byte:02X} as a signed byte is {signed(byte)}.")
            return False
        return True

    drill(1, question)


def part4():
    print("Part 4: fall off the edge.")
    print()

    def question(i, total):
        start = random.randint(100, 127)
        add = random.randint(128 - start, 60)
        bits = (start + add) & 0xFF
        answer = ask_number(
            f"[{i}/{total}] A signed byte holds {start}. "
            f"The program adds {add}. What does it hold now?"
        )
        if answer == signed(bits):
            return True
        print(f"Not quite. {start} + {add} = {start + add}, which does not fit in a signed byte.")
        print(f"The bits are {bits:08b}, and as a signed byte that is {signed(bits)}.")
        return False

    drill(1, question)


def part5():
    need = random.randint(150, 240)
    print("Part 5: break it!")
    print()
    print("Here is a guard and a vault. Both look at the SAME byte, which you choose.")
    print()
    print("  The guard reads your byte as SIGNED.")
    print("  He only lets you through if it is less than 100.")
    print()
    print("  The vault reads your byte as UNSIGNED.")
    print(f"  It only opens if it is at least {need}.")
    print()
    print(f"The guard thinks nobody below 100 could ever reach {need}. Prove him wrong.")
    print()

    while True:
        choice = ask_number("Choose your byte (a number from 0 to 255):")
        print()
        if not 0 <= choice <= 255:
            print("That does not fit in a byte. Choose a number from 0 to 255.")
            print()
            continue
        print(f"Your byte is {choice:08b}.")
        print(f"The guard reads it as {signed(choice)}.")
        if not signed(choice) < 100:
            print("That is not less than 100. The guard stops you. Try again.")
            print()
            continue
        print("That is less than 100. The guard lets you through!")
        print(f"The vault reads it as {choice}.")
        if not choice >= need:
            print(f"That is not at least {need}. The vault stays closed. Try again.")
            print()
            continue
        print(f"That is at least {need}. The vault opens!")
        print()
        return


PARTS = [part1, part2, part3, part4, part5]

if len(sys.argv) > 1 and sys.argv[1] == "restart":
    save_checkpoint(0)
    print("Progress cleared. Starting from Part 1.")
    print()

done = load_checkpoint()
if 0 < done < len(PARTS):
    print(f"Welcome back! Parts 1 to {done} are already done, continuing from Part {done + 1}.")
    print("(Run `/challenge/run restart` if you want to start from the beginning.)")
    print()

try:
    for number, part in enumerate(PARTS, 1):
        if number <= done:
            continue
        part()
        save_checkpoint(number)
        if number < len(PARTS):
            print(f"--- Part {number} done! Your progress is saved. ---")
            print()
except (EOFError, KeyboardInterrupt):
    print()
    print("See you later! Run me again to continue where you left off.")
    raise SystemExit(1)

print("Well done! Here is your flag:")
with open("/flag") as f:
    print(f.read())
