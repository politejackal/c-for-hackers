#!/usr/bin/exec-suid -- /usr/local/bin/python -I

import random

ROUNDS = 3


def fail(message):
    print(message)
    print("Run me again to retry!")
    raise SystemExit(1)


print(f"Part 1: convert {ROUNDS} bytes from binary to decimal.")
print()

for i in range(1, ROUNDS + 1):
    value = random.randint(1, 255)
    print(f"[{i}/{ROUNDS}] What is {value:08b} in decimal?")
    answer = input("> ").strip()
    if answer != str(value):
        fail(f"Not quite. {value:08b} is {value}.")
    print("Correct!")
    print()

print(f"Part 2: convert {ROUNDS} numbers from decimal to binary.")
print("Write your answer as 8 bits, like 01000001.")
print()

for i in range(1, ROUNDS + 1):
    value = random.randint(1, 255)
    print(f"[{i}/{ROUNDS}] What is {value} in binary?")
    answer = input("> ").strip().replace(" ", "")
    if not answer or any(c not in "01" for c in answer) or len(answer) > 8:
        fail("That is not a byte. Use only 0s and 1s, at most 8 of them.")
    if int(answer, 2) != value:
        fail(f"Not quite. {value} is {value:08b}.")
    print("Correct!")
    print()

print("Well done! Here is your flag:")
with open("/flag") as f:
    print(f.read())
