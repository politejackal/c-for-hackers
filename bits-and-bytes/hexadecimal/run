#!/usr/bin/exec-suid -- /usr/local/bin/python -I

import random

ROUNDS = 2


def fail(message):
    print(message)
    print("Run me again to retry!")
    raise SystemExit(1)


def read_hex(text):
    text = text.strip().lower().replace(" ", "")
    if text.startswith("0x"):
        text = text[2:]
    if not text or len(text) > 2 or any(c not in "0123456789abcdef" for c in text):
        fail("That is not a hex byte. Use 1 or 2 hex digits, like 0x41.")
    return int(text, 16)


def read_binary(text):
    text = text.strip().replace(" ", "")
    if not text or len(text) > 8 or any(c not in "01" for c in text):
        fail("That is not a byte. Use only 0s and 1s, at most 8 of them.")
    return int(text, 2)


def section(title):
    print(title)
    print()


def ask(i, question):
    print(f"[{i}/{ROUNDS}] {question}")
    return input("> ")


section(f"Part 1: hex to decimal ({ROUNDS} questions).")
for i in range(1, ROUNDS + 1):
    value = random.randint(16, 255)
    answer = ask(i, f"What is 0x{value:02X} in decimal?").strip()
    if answer != str(value):
        fail(f"Not quite. 0x{value:02X} is {value}.")
    print("Correct!")
    print()

section(f"Part 2: decimal to hex ({ROUNDS} questions).")
for i in range(1, ROUNDS + 1):
    value = random.randint(16, 255)
    answer = read_hex(ask(i, f"What is {value} in hex?"))
    if answer != value:
        fail(f"Not quite. {value} is 0x{value:02X}.")
    print("Correct!")
    print()

section(f"Part 3: binary to hex ({ROUNDS} questions).")
for i in range(1, ROUNDS + 1):
    value = random.randint(16, 255)
    answer = read_hex(ask(i, f"What is {value:08b} in hex?"))
    if answer != value:
        fail(f"Not quite. {value:08b} is 0x{value:02X}.")
    print("Correct!")
    print()

section(f"Part 4: hex to binary ({ROUNDS} questions).")
print("Write your answer as 8 bits, like 01000001.")
print()
for i in range(1, ROUNDS + 1):
    value = random.randint(16, 255)
    answer = read_binary(ask(i, f"What is 0x{value:02X} in binary?"))
    if answer != value:
        fail(f"Not quite. 0x{value:02X} is {value:08b}.")
    print("Correct!")
    print()

print("Well done! Here is your flag:")
with open("/flag") as f:
    print(f.read())
