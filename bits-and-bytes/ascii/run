#!/usr/bin/exec-suid -- /usr/local/bin/python -I

import random

ROUNDS = 2

WORDS = [
    "Hello", "hacker", "Flag", "pwn", "Stack", "byte", "Root", "Linux",
    "shell", "Heap", "debug", "Code", "bits", "Win", "Null", "crash",
]


def fail(message):
    print(message)
    print("Run me again to retry!")
    raise SystemExit(1)


def read_hex_bytes(text):
    """Accept '48 69', '0x48 0x69', '48,69' or '4869'."""
    text = text.strip().lower().replace("0x", "").replace(",", " ")
    text = "".join(text.split())
    if not text or len(text) % 2 or any(c not in "0123456789abcdef" for c in text):
        fail("That is not a list of hex bytes. Write 2 hex digits per byte, like 48 69.")
    return bytes.fromhex(text)


def show_bytes(data):
    return " ".join(f"{b:02x}" for b in data)


def ask(i, question):
    print(f"[{i}/{ROUNDS}] {question}")
    return input("> ")


print(f"Part 1: bytes to text ({ROUNDS} questions).")
print("Upper and lower case matter!")
print()
for i, word in enumerate(random.sample(WORDS, ROUNDS), 1):
    answer = ask(i, f"What word do these bytes spell?  {show_bytes(word.encode())}").strip()
    if answer != word:
        fail(f"Not quite. Those bytes spell {word}")
    print("Correct!")
    print()

print(f"Part 2: text to bytes ({ROUNDS} questions).")
print("Write the bytes in hex, like 48 69.")
print()
for i, word in enumerate(random.sample(WORDS, ROUNDS), 1):
    answer = read_hex_bytes(ask(i, f"What are the bytes of the word {word} ?"))
    if answer != word.encode():
        fail(f"Not quite. {word} is {show_bytes(word.encode())}")
    print("Correct!")
    print()

print(f"Part 3: case flip ({ROUNDS} questions).")
print()
letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
for i, letter in enumerate(random.sample(letters, ROUNDS), 1):
    other = letter.swapcase()
    question = (
        f"The byte 0x{ord(letter):02x} is a letter. "
        "What is the hex value of the same letter in the other case?"
    )
    answer = read_hex_bytes(ask(i, question))
    if answer != other.encode():
        fail(
            f"Not quite. 0x{ord(letter):02x} is {letter}, "
            f"and {other} is 0x{ord(other):02x}."
        )
    print("Correct!")
    print()

print(f"Part 4: the digit trap ({ROUNDS} questions).")
print("Answer in decimal.")
print()
for i, digit in enumerate(random.sample("0123456789", ROUNDS), 1):
    answer = ask(i, f"What number is stored for the character {digit} ?").strip()
    if answer != str(ord(digit)):
        fail(
            f"Not quite. The character {digit} is stored as {ord(digit)}, "
            f"not {answer or 'nothing'}."
        )
    print("Correct!")
    print()

print("Well done! Here is your flag:")
with open("/flag") as f:
    print(f.read())
